---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";
import { formatZhDate, toLegacyPath } from "../utils/legacy";
import { toTagSlug } from "../utils/tags";
import { getFeaturedItems, getFeaturedProjectRelatedPostIds } from "../utils/featured";

const blogEntries = (await getCollection("blog"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredItems = (await getFeaturedItems()).slice(0, 3);
const featuredProjectRelatedPostIds = await getFeaturedProjectRelatedPostIds(featuredItems.length);
const latestEntries = blogEntries.filter((entry) => !featuredProjectRelatedPostIds.has(entry.id));

const tagSet = new Set<string>();
for (const entry of blogEntries) {
  for (const tag of entry.data.tags ?? []) {
    tagSet.add(tag);
  }
}
const tags = [...tagSet].sort((a, b) => a.localeCompare(b, "zh-CN")).slice(0, 18);
---

<BaseLayout title={site.seoTitle} description={site.description} canonicalPath="/">
  <main>
    <section class="shell hero">
      <span class="hero__eyebrow">Peihong</span>
      <h1>Robotics Learning Systems for Real Hardware.</h1>
      <p>
        我关注机器人系统、三维重建、工业视觉和具身智能原型。近期重点是把真实机器人学习从“录数据、训模型、上机试”推进到可复现、可诊断、可快速迭代的实验闭环。
      </p>
      <div class="hero__links" aria-label="Profile links">
        <a href={site.social.github}>GitHub</a>
        <a href="/projects/">Projects</a>
        <a href="/blog/">Notes</a>
      </div>
    </section>

    <section class="shell section capability-strip">
      <div class="section__title">
        <h2>机器人学习效率系统</h2>
        <a href="/projects/fr3-workstation-il-closed-loop/">查看 FR3 闭环</a>
      </div>
      <div class="capability-grid">
        <article>
          <span>01</span>
          <h3>采集前移</h3>
          <p>把同步、QC、起始位姿、相机 crop、曝光和动作合同前移到训练前与 rollout 前，减少“跑完才发现数据不可用”的实验浪费。</p>
        </article>
        <article>
          <span>02</span>
          <h3>场景可恢复</h3>
          <p>Record / Rollout 页面支持基于 demo 几何和桌面投影的 scene reset：操作者刷目标区域，系统把 peg 放回可控分布。</p>
        </article>
        <article>
          <span>03</span>
          <h3>失败可定位</h3>
          <p>每次 rollout 后记录阶段评分、blocker、落点几何和 checkpoint 轨迹，不只看成功率，而是找出下一轮训练最该修的瓶颈。</p>
        </article>
      </div>
    </section>

    <section class="shell section">
      <div class="section__title">
        <h2>精选项目</h2>
        <a href="/projects/">查看全部</a>
      </div>
      <div class="grid grid--three">
        {featuredItems.map((project) => (
          <ProjectCard
            href={project.href}
            title={project.title}
            description={project.description}
            status={project.status}
            tech={project.tech}
          />
        ))}
      </div>
    </section>

    <section class="shell section">
      <div class="section__title">
        <h2>最新文章</h2>
        <a href="/blog/">进入文章列表</a>
      </div>
      <div class="grid grid--two">
        {latestEntries.slice(0, 6).map((entry) => (
          <PostCard
            href={toLegacyPath(entry.id, entry.data.date)}
            title={entry.data.title}
            subtitle={entry.data.subtitle}
            description={entry.data.description}
            dateLabel={formatZhDate(entry.data.date)}
            tags={entry.data.tags}
          />
        ))}
      </div>
    </section>

    <section class="shell section">
      <div class="section__title">
        <h2>主题标签</h2>
        <a href="/tags/">查看归档</a>
      </div>
      <div class="tag-list">
        {tags.map((tag) => <a class="tag" href={`/tags/${toTagSlug(tag)}/`}>{tag}</a>)}
      </div>
    </section>
  </main>
</BaseLayout>
